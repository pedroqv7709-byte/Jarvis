# Copy to .env and adjust. Every variable is optional; defaults are shown.

# Directory for operational data: state database (state.db) and audit log (audit.jsonl).
JARVIS_DATA_DIR=.jarvis

# The only directory filesystem tools may touch. Paths outside it are rejected.
JARVIS_WORKSPACE_DIR=sandbox

# Identifier of the local user on whose behalf Jarvis acts.
JARVIS_USER_ID=local-user

# Permission grants as JSON: scope -> allow | confirm | deny.
# Scopes not listed are denied. Wildcards like "fs.*" are supported.
# Category floors (e.g. deletions, sending messages, payments) can make a decision
# stricter than the grant, never more permissive.
JARVIS_PERMISSIONS={"fs.read": "allow", "fs.write": "allow", "fs.delete": "confirm", "windows.read": "allow", "windows.open": "allow", "windows.focus": "allow", "windows.close": "confirm"}

# --- Planning with a language model -------------------------------------------------------
# none    = deterministic planner only (default; no extra dependencies, no API key).
# litellm = model planner through LiteLLM. Requires `uv sync --extra llm` and JARVIS_MODEL.
JARVIS_MODEL_PROVIDER=none

# LiteLLM model string: "<provider>/<model>". Examples:
#   openai/gpt-4o-mini   anthropic/claude-sonnet-4-5   ollama/llama3.1
# JARVIS_MODEL=

# Optional endpoint override, e.g. a local Ollama server.
# JARVIS_MODEL_API_BASE=http://localhost:11434

# Hard limit for one planning call to the model, in seconds (never beyond the task's remaining
# time budget). LiteLLM and vendor SDK retries are disabled: one call costs at most this.
JARVIS_MODEL_TIMEOUT_SECONDS=30

# How the JSON answer is requested: json_schema | json_object | auto (schema when LiteLLM knows the
# backend supports it). The answer is always validated by Jarvis, whatever the backend promises.
JARVIS_MODEL_STRUCTURED_OUTPUT=auto

# If the model fails, times out, or returns a plan that does not validate, try the
# deterministic planner. The fallback is recorded in the audit log and shown in the response.
JARVIS_PLANNER_FALLBACK=true

# API keys are NOT Jarvis settings: LiteLLM reads its standard variables directly
# (OPENAI_API_KEY, ANTHROPIC_API_KEY, ...). Never commit real keys.

# Opt-in live validation with a real model (pytest never needs it):
#   JARVIS_LIVE_MODEL=1 [JARVIS_LIVE_WINDOWS=1] uv run pytest tests/test_live_model.py -s

# --- Agent loop hard limits (enforced by Jarvis; no planner or model can change them) ------
JARVIS_AGENT_MAX_ITERATIONS=20
JARVIS_AGENT_MAX_ACTIONS=20
JARVIS_AGENT_MAX_REPLANS=5
# Context given to the planner for each decision.
JARVIS_AGENT_HISTORY_STEPS=10
JARVIS_AGENT_MAX_OBSERVED_WINDOWS=30
JARVIS_AGENT_MAX_PROMPT_CHARS=12000

# --- Execution time limits -----------------------------------------------------------------
# Hard limit for a single tool attempt, in seconds.
JARVIS_TOOL_TIMEOUT_SECONDS=30
# Global per-task budget: tool execution + retry backoff + planning (confirmation wait excluded).
JARVIS_TASK_TIMEOUT_SECONDS=300

# Retry / loop limits.
JARVIS_MAX_ATTEMPTS_PER_ACTION=3
JARVIS_MAX_TOTAL_ATTEMPTS_PER_TASK=20
JARVIS_RETRY_BACKOFF_SECONDS=0.5
JARVIS_RETRY_BACKOFF_MULTIPLIER=2.0
JARVIS_RETRY_MAX_BACKOFF_SECONDS=5.0

# Planning / request limits.
JARVIS_MAX_PLAN_STEPS=10
JARVIS_MAX_REQUEST_CHARS=4000

# --- Windows desktop automation -------------------------------------------------------------
# auto = enabled on Windows when the optional extra is installed (`uv sync --extra windows`).
# off  = never register the Windows tools.
JARVIS_WINDOWS_AUTOMATION=auto
# Extra applications Jarvis may open/close, merged with the built-in ones (notepad, calculator).
# Absolute path to an .exe (forward slashes avoid JSON escaping); shells and script hosts (cmd, powershell, wscript, mshta, ...) are
# always refused. Example:
# JARVIS_WINDOWS_APPLICATIONS={"miapp": {"executable": "C:/Program Files/Example/app.exe", "process_names": ["app.exe"], "aliases": ["mi app"]}}
# How long to wait for an application's window to appear / disappear (seconds).
JARVIS_WINDOWS_OPEN_WAIT_SECONDS=10
JARVIS_WINDOWS_CLOSE_WAIT_SECONDS=5

# --- Local server (`jarvis server`) ---------------------------------------------------------
# The API has no authentication, so it only ever listens on loopback. Any other value
# (0.0.0.0, a LAN address, a host name other than localhost) is rejected at startup.
JARVIS_SERVER_HOST=127.0.0.1
JARVIS_SERVER_PORT=8765
# On shutdown, how long to wait for the task in progress to reach a safe point (seconds).
JARVIS_SHUTDOWN_GRACE_SECONDS=10
# The API token is NOT configured here: `jarvis server` generates a new random token at every
# start in <JARVIS_DATA_DIR>/api_token and the CLI reads it from there.
